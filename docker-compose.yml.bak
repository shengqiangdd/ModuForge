services:
  app:
    build:
      context: .
      dockerfile: backend/Dockerfile
    ports:
      - "8086:8080"
    volumes:
      # Data is persisted in ./data/ directory. Use `docker compose down` (without -v) to avoid data loss.
      - ./data:/app/data
      # Persist ADB keys across container rebuilds so devices stay authorized
      - ./data/android:/root/.android
    environment:
      - PORT=:8080
      - DATABASE_PATH=/app/data/moduforge.db
      - OPENCODE_API_KEY=${opencode_go_key:-}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--spider", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3
