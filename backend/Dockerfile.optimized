# ============================================================
# ModuForge — Optimized Multi-stage Build (Go + Rust + NDK)
# ============================================================
# BuildKit required for cache mounts
# syntax=docker/dockerfile:1

# Stage 0: Frontend build (with cache)
FROM node:22-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --include=dev
COPY frontend/ .
RUN --mount=type=cache,target=/app/node_modules/.cache npm run build

# ============================================================
# Stage 1: Go backend (with cache mounts)
FROM golang:1.25-alpine AS backend-builder
RUN apk add --no-cache gcc musl-dev
WORKDIR /app

# Go module cache — persists across builds
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

COPY backend/ .
# Build with cache mounts for go-build and module cache
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go build -ldflags="-s -w" -trimpath -o /server ./cmd/moduforge/

# ============================================================
# Stage 2: Runtime (Go compiler + Rust + Android NDK)
FROM golang:1.25-alpine AS runtime

LABEL org.opencontainers.image.title="ModuForge"

# --- Runtime deps + gcompat (NDK glibc compatibility) ---
RUN apk add --no-cache wget ca-certificates tzdata openssl curl bash xz zip unzip cmake make gcompat \
    && addgroup -S moduforge && adduser -S moduforge -G moduforge

# --- Rust toolchain (with Cargo cache mount) ---
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | env CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup sh -s -- -y \
    --default-toolchain stable \
    && /usr/local/cargo/bin/rustup target add aarch64-linux-android \
    && /usr/local/cargo/bin/rustup component add clippy rustfmt \
    && chown -R moduforge:moduforge /usr/local/cargo /usr/local/rustup

# --- Android NDK r27c (single layer, trimmed) ---
# Cache mount for NDK download — reuses if NDK version unchanged
RUN --mount=type=cache,target=/tmp/ndk-cache \
    mkdir -p /opt/android-ndk \
    && if [ ! -f /tmp/ndk-cache/ndk-done ]; then \
        wget -q https://dl.google.com/android/repository/android-ndk-r27c-linux.zip -O /tmp/ndk-cache/ndk.zip \
        && unzip -q /tmp/ndk-cache/ndk.zip -d /tmp/ndk-cache/ndk_tmp \
        && touch /tmp/ndk-cache/ndk-done; \
    fi \
    && mv /tmp/ndk-cache/ndk_tmp/android-ndk-r27c/toolchains/llvm/prebuilt/linux-x86_64/bin /opt/android-ndk/bin \
    && mv /tmp/ndk-cache/ndk_tmp/android-ndk-r27c/toolchains/llvm/prebuilt/linux-x86_64/lib /opt/android-ndk/lib \
    && mv /tmp/ndk-cache/ndk_tmp/android-ndk-r27c/toolchains/llvm/prebuilt/linux-x86_64/sysroot /opt/android-ndk/sysroot \
    && chmod -R 755 /opt/android-ndk

# --- Copy backend binary ---
COPY --from=backend-builder --chown=moduforge:moduforge /server /server

# --- Copy frontend dist ---
COPY --from=frontend-builder --chown=moduforge:moduforge /app/dist /app/dist

# --- Entrypoint ---
COPY --chown=moduforge:moduforge docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# --- Runtime defaults ---
ENV PORT=:8080 \
    DATABASE_PATH=/data/moduforge.db \
    BUILD_DIR=/data/builds \
    MODULES_DIR=/data/modules \
    PROJECTS_DIR=/data/projects \
    GIN_MODE=release \
    DIST_DIR=/app/dist \
    PATH="/usr/local/cargo/bin:/usr/local/go/bin:${PATH}" \
    CARGO_HOME="/usr/local/cargo" \
    RUSTUP_HOME="/usr/local/rustup"

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT}/health || exit 1

RUN mkdir -p /data /app/uploads && chown -R moduforge:moduforge /data /app/uploads

EXPOSE 8080
USER moduforge
ENTRYPOINT ["/docker-entrypoint.sh"]
